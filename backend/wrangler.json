
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liveaction-ai-backend",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "liveaction-ai-videos"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
